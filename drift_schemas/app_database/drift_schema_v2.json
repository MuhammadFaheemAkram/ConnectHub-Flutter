  "fixed_sql": [
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"avatar_url\" TEXT NULL, \"bio\" TEXT NOT NULL, \"followers_count\" INTEGER NOT NULL, \"following_count\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "posts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"posts\" (\"id\" TEXT NOT NULL, \"author_id\" TEXT NOT NULL REFERENCES users (id), \"content\" TEXT NOT NULL, \"image_url\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"like_count\" INTEGER NOT NULL, \"comment_count\" INTEGER NOT NULL, \"is_liked\" INTEGER NOT NULL CHECK (\"is_liked\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "feed_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feed_items\" (\"post_id\" TEXT NOT NULL REFERENCES posts (id) ON DELETE CASCADE, PRIMARY KEY (\"post_id\"));"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"post_id\" TEXT NOT NULL REFERENCES posts (id) ON DELETE CASCADE, \"bookmarked_at\" TEXT NOT NULL, PRIMARY KEY (\"post_id\"));"
        }
      ]
    },
    {
      "name": "comments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"comments\" (\"id\" TEXT NOT NULL, \"post_id\" TEXT NOT NULL REFERENCES posts (id) ON DELETE CASCADE, \"author_id\" TEXT NOT NULL REFERENCES users (id), \"content\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
